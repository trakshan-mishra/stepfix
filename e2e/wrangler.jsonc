{
  "name": "stepfix-e2e",
  "main": "../src/server.ts",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/agents/*", "/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "SupportSession", "class_name": "SupportSession" },
      { "name": "Coordinator", "class_name": "Coordinator" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SupportSession", "Coordinator"] }
  ],
  "vars": {
    "APP_ENV": "development",
    "LLM_MODE": "mock",
    "MAX_ACTIVE_SESSIONS": "100",
    "CHAOS": ""
  }
}
